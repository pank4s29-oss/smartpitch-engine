{
  "rewrites": [
    { "source": "/api/domain-profiles/:id/pain-points", "destination": "/api/pain-points-hub?id=:id" },
    { "source": "/api/domain-profiles/:id/pain-points/suggest", "destination": "/api/pain-points-hub?id=:id&action=suggest" },
    { "source": "/api/domain-profiles/:id/pain-points/extract", "destination": "/api/pain-points-hub?id=:id&action=extract" },
    { "source": "/api/generation-requests", "destination": "/api/generation-requests-hub" },
    { "source": "/api/generation-requests/:id", "destination": "/api/generation-requests-hub?id=:id" },
    { "source": "/api/swipe-copies", "destination": "/api/swipe-copies-hub" },
    { "source": "/api/swipe-copies/:id", "destination": "/api/swipe-copies-hub?id=:id" },
    { "source": "/api/raw-feedback", "destination": "/api/raw-feedback-hub" },
    { "source": "/api/raw-feedback/:id", "destination": "/api/raw-feedback-hub?id=:id" }
  ],
  "functions": {
    "api/generation-requests-hub.js": {
      "maxDuration": 60
    },
    "api/swipe-copies-hub.js": {
      "maxDuration": 30
    },
    "api/pain-points-hub.js": {
      "maxDuration": 45
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
